{
  "name": "midang",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start:frontend": "yarn workspace @architecture-firm/frontend start",
    "start:backend": "yarn workspace @architecture-firm/backend start",
    "start": "concurrently \"yarn start:frontend\" \"yarn start:backend\"",
    "build": "yarn workspaces run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "typescript": "^5.1.6"
  }
}
